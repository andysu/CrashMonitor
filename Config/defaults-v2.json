{
  "SchemaVersion": 2,
  "SampleIntervalSeconds": 3,
  "HeartbeatIntervalSeconds": 2,
  "EventPollSeconds": 3,
  "EventBackfillHours": 48,
  "EventBatchSize": 500,
  "WorkerStallSeconds": 300,
  "MaxLogSizeMB": 32,
  "RetentionHours": 4,
  "MaxEventXmlFiles": 10000,
  "MinFreeSpaceMB": 512,
  "MaxIncidents": 100,
  "MaxEvidenceMB": 512,
  "EnableHardwareSensors": false,
  "IgnoredTemperatureSensors": [],
  "EnableUdpHeartbeat": false,
  "UdpHeartbeatHost": "127.0.0.1",
  "UdpHeartbeatPort": 514,
  "OptionalEventChannels": [
    "Microsoft-Windows-WindowsUpdateClient/Operational",
    "Microsoft-Windows-Storage-Storport/Operational"
  ],
  "HardwareEventChannels": [
    { "Name": "Microsoft-Windows-Kernel-WHEA/Errors", "MaxLevel": 4 },
    { "Name": "Microsoft-Windows-Kernel-WHEA/Operational", "MaxLevel": 4 },
    { "Name": "Microsoft-Windows-Kernel-Power/Thermal-Operational", "MaxLevel": 4 },
    { "Name": "Microsoft-Windows-Ntfs/Operational", "MaxLevel": 3 },
    { "Name": "Microsoft-Windows-Storage-ClassPnP/Operational", "MaxLevel": 2, "EventDataFilter": "(Data[@Name='SenseKey']!='2' or Data[@Name='AdditionalSenseCode']!='58') and Data[@Name='SenseKey']!='5'" }
  ]
}
