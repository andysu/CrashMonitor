# Auto detect text files and perform LF normalization
* text=auto

# Windows PowerShell scripts require CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.md text eol=lf
# Git hooks run under sh; CRLF would break them
.githooks/* text eol=lf

# Binaries
*.dll binary
*.exe binary
*.sys binary
*.zip binary
